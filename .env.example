# gotify-mcp environment variables
# Copy to .env and fill in your values.
#
# SPLIT BETWEEN THIS FILE AND config.toml:
#   .env         — secrets, URLs, and runtime Docker vars (never commit)
#   config.toml  — all other config (host, port, server_name, auth_mode, etc.)
#
# GOTIFY_*      = upstream Gotify server connection
# GOTIFY_MCP_*  = MCP server auth + bind settings

# --- Upstream Gotify server ---

# URL of your Gotify server (required)
GOTIFY_URL=https://gotify.example.com

# Client token (starts with C) — used for all management operations
# List messages, apps, clients; create/delete apps and clients; read user info.
# Do NOT use an app token here.
GOTIFY_CLIENT_TOKEN=Cxxxxxxxxxxxxxxx

# App token (starts with A) — used only for sending messages (POST /message)
# Do NOT use a client token here.
GOTIFY_APP_TOKEN=Axxxxxxxxxxxxxxx

# --- MCP server auth ---

# Static bearer token for MCP HTTP authentication.
# All requests to /mcp must include: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32  or  just gen-token
# Leave unset only when GOTIFY_MCP_NO_AUTH=true or binding to loopback.
GOTIFY_MCP_TOKEN=your_bearer_token_here

# Disable MCP auth entirely (useful behind a reverse proxy that enforces auth).
# GOTIFY_MCP_NO_AUTH=true

# Google OAuth credentials — required when config.toml [mcp.auth] mode = "oauth"
# Create a Web application OAuth client at https://console.cloud.google.com
# Set redirect URI to: ${GOTIFY_MCP_PUBLIC_URL}/auth/google/callback
# GOTIFY_MCP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOTIFY_MCP_GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Docker Compose runtime vars ---

# Container user/group (default: current user)
# GOTIFY_UID=1000
# GOTIFY_GID=1000

# Docker network name (must already exist: docker network create jakenet)
DOCKER_NETWORK=jakenet

# Image version override (default: latest)
# GOTIFY_MCP_VERSION=0.1.0

# Rust log filter
RUST_LOG=info
