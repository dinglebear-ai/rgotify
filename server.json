{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.dinglebear/rgotify",
  "title": "Gotify RMCP",
  "description": "Gotify notifications and app, client, and message management over MCP and CLI.",
  "version": "0.1.2",
  "websiteUrl": "https://rgotify.dinglebear.ai",
  "repository": {
    "url": "https://github.com/dinglebear-ai/rgotify",
    "source": "github",
    "id": "1238227288"
  },
  "icons": [
    {
      "src": "https://avatars.githubusercontent.com/u/38927646?v=4",
      "mimeType": "image/png",
      "sizes": [
        "460x460"
      ],
      "theme": "dark"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dinglebear/rgotify",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run Gotify RMCP over stdio.",
          "format": "string",
          "isRequired": true,
          "isSecret": false,
          "isRepeated": false
        }
      ],
      "environmentVariables": [
        {
          "name": "GOTIFY_URL",
          "description": "Gotify server base URL.",
          "format": "string",
          "isRequired": true,
          "isSecret": false,
          "placeholder": "https://gotify.example.com"
        },
        {
          "name": "GOTIFY_CLIENT_TOKEN",
          "description": "Gotify client token for read and management actions.",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GOTIFY_APP_TOKEN",
          "description": "Gotify app token for sending notifications.",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GOTIFY_RMCP_VERSION",
          "description": "Optional GitHub release tag override for the downloaded Gotify RMCP binary.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "placeholder": "v0.1.2"
        },
        {
          "name": "GOTIFY_RMCP_REPO",
          "description": "Optional GitHub owner/repo override for release asset downloads.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "dinglebear-ai/rgotify",
          "placeholder": "dinglebear-ai/rgotify"
        },
        {
          "name": "GOTIFY_RMCP_RELEASE_BASE_URL",
          "description": "Optional release download base URL override.",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "RUST_LOG",
          "description": "Tracing filter for Gotify RMCP logs.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "info",
          "placeholder": "info"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "namespace": "ai.dinglebear",
      "dnsDomain": "dinglebear.ai",
      "distribution": {
        "npm": "@dinglebear/rgotify@0.1.2",
        "nodePackage": "@dinglebear/rgotify"
      },
      "buildInfo": {
        "version": "0.1.2",
        "repository": "https://github.com/dinglebear-ai/rgotify"
      }
    }
  }
}
